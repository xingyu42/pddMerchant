# ─────────────────────────────────────────────────
# pdd-cli 环境变量覆盖示例
# 普通运行默认值统一来自 config/config.example.json；本机差异优先写入
# config/config.json。环境变量是更高优先级覆盖层，适合临时覆盖和敏感值。
# ─────────────────────────────────────────────────

# ── 鉴权 ──────────────────────────────────────────

# 商家端显式登录态文件路径
# 未注册时默认 data/merchant/stores/default/auth-state.json；注册后使用 registry 记录的 <slug>/auth-state.json
# PDD_AUTH_STATE_PATH=

# 消费者端显式登录态文件路径
# 未注册时默认 data/consumer/accounts/default/auth-state.json；注册后使用 registry 记录的 <slug>/auth-state.json
# 供消费者登录、doctor 和 goods publish 源商品抓取等消费者账号流程使用
# PDD_CONSUMER_AUTH_STATE_PATH=

# 商家店铺目录与注册表覆盖（默认 data/merchant/stores/ 与其 registry.json）
# PDD_ACCOUNTS_DIR=
# PDD_ACCOUNT_REGISTRY_PATH=

# 消费者账号目录与注册表覆盖（默认 data/consumer/accounts/ 与其 registry.json）
# PDD_CONSUMER_ACCOUNTS_DIR=
# PDD_CONSUMER_ACCOUNT_REGISTRY_PATH=

# 消费者端登录页地址（默认值见 config/config.example.json）
# PDD_CONSUMER_LOGIN_URL=

# POSIX 无法把登录态权限设为 0600 时允许继续（不推荐，仅用于明确接受权限风险的环境）
# PDD_ALLOW_INSECURE_AUTH_STATE=0

# ── 店铺 ──────────────────────────────────────────

# 默认店铺 ID（省略 --mall 参数时使用）
# PDD_DEFAULT_MALL=

# Mall ID 解析模式：1 = 严格（1-15 位数字），0 = 宽松（最长 64 字符）
# PDD_MALL_ID_STRICT_PARSE=1

# ── 商品发布 ──────────────────────────────────────

# 第三方类目解析 API 地址（默认值见 config/config.example.json）
# PDD_CATEGORY_API_BASE=

# 满 2 件折扣率：0.50-0.99；也支持 50-99 百分比格式，步长 0.01
# 默认 0.95，即页面显示 9.5 折
# PDD_FULL_COUNT_DISCOUNT_RATE=0.95

# 写操作每分钟令牌数（默认值见 config/config.example.json）
# PDD_WRITE_RATE_TPM=20

# 连续软封多少次后进入长冷却
# PDD_SCRAPE_SOFTBLOCK_THRESHOLD=2

# 源商品抓取软封冷却时长（毫秒）
# PDD_SCRAPE_SOFTBLOCK_COOLDOWN_MS=7200000

# ── 源商品抓取代理（可选）─────────────────────────

# 仅代理 goods publish 的消费者端源商品抓取；商家后台和其他命令保持直连
# 留空时使用默认直连；当前仅支持 qingguo
# PDD_SOURCE_PROXY_PROVIDER=qingguo

# 青果按量提取接口的 AuthKey（作为 /get 接口的 key 参数）
# PDD_QINGGUO_AUTH_KEY=

# 青果提取地区（可选，6 位地区代码；多个用英文逗号分隔；留空为随机地区）
# PDD_QINGGUO_AREA=350500,330700

# 首版不配置代理节点账号/密码鉴权；配置或代理失败不会自动回退直连
# 不要提交填写了真实凭据的 .env 文件

# ── 限流 ──────────────────────────────────────────

# 全局请求频率（QPS），默认值见 config/config.example.json
# PDD_RATE_LIMIT_QPS=2

# 突发请求上限，默认值见 config/config.example.json
# PDD_RATE_LIMIT_BURST=3

# 连续 429 触发全局冷却的阈值次数，默认值见 config/config.example.json
# PDD_COOLDOWN_THRESHOLD=3

# 全局冷却时长（毫秒），默认值见 config/config.example.json
# PDD_COOLDOWN_MS=300000

# ── 超时 ──────────────────────────────────────────

# 全局命令超时（毫秒），默认无限制
# PDD_TIMEOUT_MS=

# ── 日志 ──────────────────────────────────────────

# 日志级别：trace | debug | info | warn | error | fatal
# PDD_LOG_LEVEL=warn

# 运行日志固定写入 log/（按 channel 分目录、按本地日轮转，不可配置路径）
# CLI: log/cli/YYYY-MM-DD.log
# foreground/bootstrap: stderr

# 将剥离前的 raw 值经脱敏、截断后写入 stderr JSONL；不影响 stdout envelope
# PDD_DEBUG_RAW=0

# ── 测试 ──────────────────────────────────────────

# 设为 fixture 启用 mock 模式（跳过真实浏览器）
# PDD_TEST_ADAPTER=

# fixture 数据目录（默认 test/fixtures/）
# PDD_TEST_FIXTURE_DIR=

# 设为 1 模拟登录态失效
# PDD_TEST_AUTH_INVALID=

# 设为 1 模拟消费者登录态失效
# PDD_TEST_CONSUMER_AUTH_INVALID=

# ── 当前未生效/未完整接入 ──────────────────────────

# 以下字段没有完整生产调用链，不属于有效运行配置，请勿依赖：
# PDD_IMAGE_TRANSFORM=
# PDD_PUBLISH_COST_TEMPLATE_ID=

# ── Patchright ────────────────────────────────────

# 浏览器下载镜像（国内加速）
# PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright/
