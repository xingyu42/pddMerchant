{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "test/**/*.test.js"
  ],
  "project": [
    "src/**/*.js",
    "bin/**/*.js",
    "!src/console/**"
  ],
  "ignoreDependencies": [],
  "ignore": [
    "src/console/**",
    // Transitional mall-writer shim retained until legacy adapter cleanup & skill doc updates.
    "src/adapter/mall-writer.js"
  ]
}
